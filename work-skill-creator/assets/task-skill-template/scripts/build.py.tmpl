PERIOD_KIND = "{{KIND}}"     # Q 분기 · M 월 · H 반기 · Y 연
FY_END = 12                  # 회계연도 마지막 달(3월 결산이면 3)
MODE = "이어받기"            # "이어받기"(지난 완성본 사본에서 바뀌는 칸만) | "새로 만들기"(FORM 양식에서)
FORM = ""                    # 새로 만들기일 때 양식 파일(스킬 폴더 기준, 예: assets/양식.xlsx)
NEEDS_JUDGMENT = True        # 사람이 정할 것이 없는 업무면 False(예약 작업용)
NEEDS_EXCEL = True           # 엑셀로 다시 계산해야 하는 결과물(xlsx)이면 True

IN_DIR, WORK_DIR, OUT_DIR = "01_받은자료", "02_작업", "03_산출"   # 작업 폴더 이름이 다르면 여기만 바꾼다
# 이름 규칙 자리: {ym} 2026-06 · {dot} 2026.06 · {yq} 2026-2Q · {fy} FY26.2Q · {q} 2 · {year} 2026 · {mm} 06 · * 아무 글자
#                {m} = 기간 안의 각 달(분기면 석 달 - 그 달들 이름을 모두 찾는다)
PRIOR_NAME = "TODO_{ym}.xlsx"              # 지난 기간 완성본(틀)
RAW_NAMES = {"원자료": "TODO_{ym}.xlsx"}   # 이번 기간 원자료(여러 개면 더 적는다)
# 키 끝에 * 를 붙이면 '0개 이상'(없어도 되고 여러 개일 수 있음) - 예: {"계약서*": "계약서_{m}_*.pdf"} → inputs["계약서"] = [경로, …]
OUT_NAME = "TODO_{ym}.xlsx"                # 결과 파일
JUDGMENT_NAME = "판단입력_{ym}.json"
KNOWN_DIFFS = HERE.parent / "references" / "known_diffs.txt"   # 재현 시험에서 뺄 범위(이유와 함께)


def fill_name(pattern: str, p: W.Period, m: W.Period | None = None) -> str:
    return pattern.format(ym=p.ym, dot=p.dot, yq=p.yq, fy=p.fy, q=p.q, year=p.year, mm=f"{p.month:02d}",
                          m=(m or p).ym)


def candidates(folder: Path, pattern: str) -> list[Path]:
    """이름 규칙에 맞는 파일(최근 수정순). '*' 가 있으면 여러 개일 수 있다."""
    if not folder.is_dir():
        return []
    if any(ch in pattern for ch in "*?["):
        hits = [x for x in folder.glob(pattern) if x.is_file() and not x.name.startswith("~$")]
    else:
        hits = [folder / pattern] if (folder / pattern).exists() else []
    return sorted(hits, key=lambda x: x.stat().st_mtime, reverse=True)


def at_root(root: Path, s: str) -> Path:
    p = Path(s)
    return p if p.is_absolute() else root / p


# ── 1. 입력 찾기 ───────────────────────────────────────────────
def find_inputs(a, period: W.Period, root: Path) -> tuple[dict, list[str], list[str]]:
    """({'prior', <원자료 키>…, 'judgment', 'out'}, 멈춤, 경고)."""
    stops, warns, inputs = [], [], {}
    prev = period.prev()
    if MODE == "새로 만들기":
        form = (HERE.parent / FORM) if FORM and (HERE.parent / FORM).exists() else at_root(root, FORM or "?")
        if not FORM or not form.exists():
            stops.append(f"양식 파일(FORM)이 없습니다: {FORM or '(비어 있음)'}")
        inputs["prior"] = form
    elif a.prior:
        inputs["prior"] = at_root(root, a.prior)
        if not inputs["prior"].exists():
            stops.append(f"지정한 지난 기간 완성본이 없습니다: {inputs['prior']}")
    else:
        name = fill_name(PRIOR_NAME, prev)
        c_in, c_out = candidates(root / IN_DIR, name), candidates(root / OUT_DIR, name)
        inputs["prior"] = c_in[0] if c_in else root / IN_DIR / name
        if len(c_in) > 1:
            stops.append(f"지난 기간({prev.ym}) 완성본 후보가 여럿입니다: {', '.join(x.name for x in c_in)}"
                         f" - 사람이 확정한 판을 --prior 로 지정하세요")
        elif not c_in and c_out:
            stops.append(f"지난 기간({prev.ym}) 완성본이 {OUT_DIR}(코드가 만든 파일)에만 있습니다: {c_out[0].name}"
                         f" - 사람이 검토 · 확정한 판이면 {IN_DIR} 에 두거나 --prior 로 지정하세요")
        elif not c_in:
            stops.append(f"지난 기간({prev.ym}) 완성본이 없습니다: {root / IN_DIR / name}  (--prior 로 지정 가능)")
    keys = {k.rstrip("*"): k for k in RAW_NAMES}
    given: dict[str, list[Path]] = {}
    for item in a.raw:
        if "=" not in item:
            stops.append(f"--raw 는 키=경로 모양입니다(키: {', '.join(keys)}): {item}")
            continue
        k, v = item.split("=", 1)
        if k not in keys:
            stops.append(f"모르는 원자료 키 '{k}' (쓸 수 있는 키: {', '.join(keys)})")
        given.setdefault(k, []).append(at_root(root, v))
    for name, key in keys.items():
        pattern, many = RAW_NAMES[key], key.endswith("*")
        if name in given:
            found = given[name]
        else:
            months = period.months() if "{m}" in pattern else [None]
            found = []
            for m in months:
                for c in candidates(root / IN_DIR, fill_name(pattern, period, m)):
                    if c not in found:
                        found.append(c)
            found.sort(key=lambda x: x.name)
        missing = [x for x in found if not x.exists()]
        for x in missing:
            stops.append(f"지정한 {name} 파일이 없습니다: {x}")
        if many:
            inputs[name] = found  # 0개도 된다 - 계획에 개수와 이름을 보여 준다
            continue
        if len(found) > 1:
            warns.append(f"{name} 후보가 여럿 - 가장 최근 것을 씀: {max(found, key=lambda x: x.stat().st_mtime).name}"
                         f" (다르면 --raw {name}=경로)")
            found = [max(found, key=lambda x: x.stat().st_mtime)]
        if not found:
            stops.append(f"이번 기간({period.ym}) {name}가 없습니다: {root / IN_DIR / fill_name(pattern, period)}")
            inputs[name] = root / IN_DIR / fill_name(pattern, period)
        else:
            inputs[name] = found[0]
    j = at_root(root, a.judgment) if a.judgment else root / WORK_DIR / fill_name(JUDGMENT_NAME, period)
    if a.judgment and not j.exists():
        stops.append(f"지정한 판단 입력 파일이 없습니다: {j}")
    inputs["judgment"] = j if j.exists() else None
    out = at_root(root, a.out) if a.out else root / OUT_DIR / fill_name(OUT_NAME, period)
    if a.expect and out.exists():  # 재현 시험은 여러 번 돌리므로 이름 끝에 시각을 붙인다
        out = out.with_name(f"{out.stem}_{dt.datetime.now():%H%M%S}{out.suffix}")
        warns.append(f"재현 결과 이름이 이미 있어 새 이름으로 만듭니다: {out.name}")
    inputs["out"] = out
    return inputs, stops, warns


def load_judgment(path: Path | None) -> tuple[dict, list[str]]:
    if not path:
        return {}, []
    try:
        return json.loads(Path(path).read_text(encoding="utf-8-sig")), []
    except json.JSONDecodeError as e:
        return {}, [f"판단 입력 파일 형식 오류({Path(path).name} {e.lineno}행): {e.msg}"]


# ── 2. 계획 ───────────────────────────────────────────────────
def make_plan(inputs: dict, judgment: dict, period: W.Period, asof: dt.date, ctx: dict) -> tuple[list[str], list[str], list[str], list[str]]:
    """(계획 줄, 멈춤, 경고, 사용자에게 물을 것). 파일은 읽기만 한다.

    읽은 자료(원자료 표 · 합계 · 판단 항목 목록)는 ctx 에 담아 두면 build() 가 다시 읽지 않고 쓴다.
    판단 항목은 답이 있어도 목록으로 보여 준다(답 있음 / 없음) - 답이 없는 것만 asks 에 넣는다.
    '하지 않기로 한 결정'(예: 위험 표시만 하고 명단에는 안 넣음)도 판단 입력에 적어 두면 다음 기간에 같은 질문을 덜 한다.
    """
    lines, stops, warns, asks = [], [], [], []
    lines.append(f"기간: {period.kor} (기준일 {asof})  ·  지난 기간: {period.prev().ym}  ·  방식: {MODE}")
    lines.append(f"틀: {inputs['prior']}")
    for k, v in inputs.items():
        if k not in ("prior", "judgment", "out"):
            if isinstance(v, list):
                lines.append(f"{k}: {len(v)}개" + ("" if not v else " - " + ", ".join(x.name for x in v)))
            else:
                lines.append(f"{k}: {v}")
    out = inputs["out"]
    lines.append(f"결과: {out}" + ("  ← 이미 있음(멈춤)" if out.exists() else ""))
    if out.exists():
        stops.append(f"결과 파일이 이미 있습니다(덮어쓰지 않음): {out}")
    raws = [x for k, v in inputs.items() if k not in ("prior", "judgment", "out") for x in (v if isinstance(v, list) else [v])]
    for p in [inputs["prior"], out] + raws:
        if p and Path(p).exists() and W.is_locked(Path(p)):
            stops.append(f"엑셀에 열려 있는 파일: {p} - 닫아 주세요(창이 안 보이면 wsc_xl.py --cleanup)")
    if NEEDS_EXCEL:
        try:
            import win32com.client  # noqa: F401
        except ImportError:
            stops.append("pywin32 가 없습니다 - python -m pip install pywin32 (윈도우 + 데스크톱 엑셀 필요)")
    if NEEDS_JUDGMENT and not ctx.get("trial"):
        if not judgment:
            asks.append(f"판단 입력 파일이 없습니다({WORK_DIR}/{fill_name(JUDGMENT_NAME, period)}) - 아래 판단 항목을 사용자에게 묻고 만듭니다")
        else:
            if str(judgment.get("기간", "")) != period.ym:
                stops.append(f"판단 입력의 기간({judgment.get('기간')})이 이번 기간({period.ym})과 다릅니다 - 이번 기간 판단을 다시 받으세요")
            lines.append(f"판단 입력: {inputs['judgment']}")
            lines.append(f"  근거: {judgment.get('_근거', '(없음 - 누가 언제 정했는지 적으세요)')}")
            lines.append(f"  항목: {', '.join(k for k in judgment if not k.startswith('_') and k not in ('기간', '판단확인'))}")
            if not judgment.get("판단확인"):
                asks.append("판단확인이 false - 사용자 답을 받은 뒤에만 true 로 바꿉니다")
    if period.is_year_start:
        warns.append("그해 첫 기간입니다 - 연초 이월 · 연간 갱신 처리(SKILL.md 3절)를 확인하세요")
    if ctx.get("trial"):
        warns.append("시험 실행(--trial) - 판단 입력 확인 없이 02_작업 에만 만듭니다. 결과를 넘기지 않습니다")
    # TODO: 원자료를 읽어 줄 수 · 합계 · 기준일을 lines 에 보여 주고(ctx 에 담기), 기준일이 asof 와 다르면 stops 에 넣는다.
    # TODO: 지난 기간에 없던 항목(새 계약 · 새 계정 등)이 있으면 stops 또는 asks 에 넣는다.
    # TODO: 판단이 필요한 항목을 찾아 asks 에 넣는다(답이 judgment 에 있으면 lines 에 보여 준다).
    return lines, stops, warns, asks


