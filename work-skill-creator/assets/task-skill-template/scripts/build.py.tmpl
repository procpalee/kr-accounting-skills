def run_expect(made: Path, expect: Path, a) -> int:
    """재현 시험 - 결과물 종류에 맞는 비교 도구로, known_diffs 범위는 빼고."""
    extra = shlex.split(a.cmp, posix=False) if a.cmp else []
    if made.suffix.lower() in (".docx", ".pptx"):
        try:
            import compare_docs as CD
        except ImportError:
            print("[멈춤] compare_docs.py 가 없습니다 - 뼈대를 --docs 로 만들거나 work-skill-creator 에서 복사하세요")
            return 1
        return CD.main([str(made), str(expect)] + extra)
    import compare_xlsx as CX
    args = [str(made), str(expect)] + (["--formats"] if a.formats else [])
    if KNOWN_DIFFS.exists():
        args += ["--ignore-file", str(KNOWN_DIFFS)]
    return CX.main(args + extra)


# ── 실행 ─────────────────────────────────────────────────────
def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="{{TITLE}}")
    ap.add_argument("--period", required=True, help="이번 기간 말 (예: 2026-09)")
    ap.add_argument("--asof", default="", help="기준일이 기간 말이 아닐 때 YYYY-MM-DD")
    ap.add_argument("--root", default="", help="작업 폴더(기본: 지금 폴더)")
    ap.add_argument("--prior", default="", help="지난 기간 완성본(사람이 확정한 판)")
    ap.add_argument("--raw", action="append", default=[], help="원자료 키=경로 (여러 번 가능)")
    ap.add_argument("--judgment", default="", help="판단 입력 JSON (기본 02_작업/판단입력_<기간>.json)")
    ap.add_argument("--out", default="", help="결과 경로(재현 시험은 02_작업 아래로)")
    ap.add_argument("--apply", action="store_true", help="실제로 만든다(없으면 계획만)")
    ap.add_argument("--expect", default="", help="재현 시험: 비교할 완성본")
    ap.add_argument("--formats", action="store_true", help="재현 시험에서 서식까지 비교")
    ap.add_argument("--trial", action="store_true", help="시험 실행: 판단 입력 없이도 02_작업/시험_… 에 만든다(넘기지 않는 파일)")
    ap.add_argument("--cmp", default="", help="비교 도구에 더 넘길 옵션(예: \"--blank-zero --tol 0.5\")")
    a = ap.parse_args(argv)

    root = Path(a.root).resolve() if a.root else Path.cwd()
    try:
        period = W.Period(a.period, PERIOD_KIND, fy_end=FY_END)
        asof = dt.date.fromisoformat(a.asof) if a.asof else period.end
    except ValueError as e:
        print(f"[멈춤] {e}")
        return 1
    print(f"작업 폴더: {root}")
    if a.trial:
        if not a.out:
            a.out = str(Path(WORK_DIR) / f"시험_{fill_name(OUT_NAME, period)}")
        if (root / OUT_DIR).resolve() in at_root(root, a.out).resolve().parents:
            print(f"[멈춤] 시험 실행 결과는 {OUT_DIR} 에 쓰지 않습니다 - --out 을 {WORK_DIR} 아래로")
            return 1
    ctx = {"trial": a.trial}
    inputs, stops, warns = find_inputs(a, period, root)
    judgment, jerr = load_judgment(inputs.get("judgment"))
    stops += jerr
    lines, asks = [], []
    if not stops:
        lines, s2, w2, asks = make_plan(inputs, judgment, period, asof, ctx)
        stops += s2
        warns += w2

    print("[계획]" if not a.apply else "[실행]")
    for x in lines:
        print("  " + x)
    for x in warns:
        print(f"  [경고] {x}")
    for x in asks:
        print(f"  [판단 필요] {x}")
    for x in stops:
        print(f"  [멈춤] {x}")
    if stops:
        return 1
    if not a.apply:
        print("\n계획만 보여 줬습니다. 판단을 확인받은 뒤 --apply 로 만듭니다.")
        return 0
    if asks and not a.trial:
        print("\n[멈춤] 판단이 정해지지 않았습니다 - 사용자에게 묻고 판단 입력 파일을 만든 뒤 다시 실행합니다.")
        return 1

    out = inputs["out"]
    work = out.with_name(f"{out.stem}.작업중{out.suffix}")
    W.check_unlocked(inputs["prior"], out, work)
    if work.exists():
        work.unlink()  # 지난 실행이 남긴 작업중 파일
    W.copy_new(inputs["prior"], work)            # 이어받기 - 틀(또는 양식) 사본
    try:
        recalculated = build(inputs, judgment, period, asof, work, ctx)
        if NEEDS_EXCEL and not recalculated:
            W.excel_recalc(work)                 # openpyxl 은 계산하지 않는다
        checks = verify(work, inputs, period, ctx)
    except BaseException:
        try:
            work.unlink()                        # 반쪽 파일을 남기지 않는다
        except OSError:
            print(f"[주의] 작업중 파일을 지우지 못했습니다: {work}")
        raise
    bad = [c for c in checks if not c[1]]
    final = out if not bad else out.with_name(f"{out.stem}_확인필요{out.suffix}")
    if final.exists():
        final = final.with_name(f"{final.stem}_{dt.datetime.now():%H%M%S}{final.suffix}")
    work.rename(final)
    print(f"\n만듦: {final}")
    for name, ok, desc in checks:
        print(f"  {'✓' if ok else '✗'} {name} {desc}")
    code = 0
    if not checks:
        print("[경고] 검산 항목이 없습니다 - verify() 를 채우기 전에는 결과를 넘기지 않습니다.")
        code = 1
    if bad:
        print(f"[확인 필요] 검산 {len(bad)}개 불일치 - 결과 이름에 '_확인필요' 를 붙였습니다. 원인을 찾기 전에는 넘기지 않습니다.")
        code = 1
    if a.expect:
        code = run_expect(final, at_root(root, a.expect), a) or code
    return code


if __name__ == "__main__":
    sys.exit(main())
